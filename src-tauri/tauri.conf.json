{
    "productName": "MultiStream",
    "version": "0.2.0",
    "identifier": "com.kradnoel.multistreamviewer",
    "build": {
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../dist",
        "removeUnusedCommands": true
    },
    "app": {
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; media-src 'self' blob: https:; frame-src https://player.twitch.tv https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' ipc: http://ipc.localhost ws://localhost:3000 ws://localhost:1421 https:"
        },
        "windows": [
            {
                "title": "Multi Stream Viewer",
                "fullscreen": false,
                "resizable": true,
                "width": 1280,
                "height": 720,
                "minWidth": 800,
                "minHeight": 600,
                "maxWidth": 3840,
                "maxHeight": 2160,
                "center": true,
                "decorations": true,
                "transparent": false
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
        "../assets/icons/32x32.png",
        "../assets/icons/128x128.png",
        "../assets/icons/128x128@2x.png",
        "../assets/icons/icon.icns",
        "../assets/icons/icon.ico"
        ],
        "publisher": "Kradnoel",
        "copyright": "Copyright © 2026 Kradnoel"
    },
    "plugins": {
        "updater": {
            "active": false
        }
    }
}
